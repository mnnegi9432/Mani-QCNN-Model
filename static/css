/*====================================================
                    GENERAL
====================================================*/

body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: url("../images/qml_bg.png") no-repeat center center fixed;
    background-size: cover;
    min-height: 100vh;
}

body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, .25);
    z-index: -1;
}

/*====================================================
                CONTAINER
====================================================*/

.container {
    max-width: 1200px;
}

/*====================================================
                TITLES
====================================================*/

h1 {
    color: #1565C0;
    font-weight: 700;
}

.lead {
    color: #333;
    font-size: 20px;
}

/*====================================================
                CARD
====================================================*/

.card {
    background: rgba(255, 255, 255, .95);
    border: none;
    border-radius: 20px;
    backdrop-filter: blur(12px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, .18);
}

.card h4 {
    color: #1565C0;
    font-weight: 700;
}

.card p {
    color: #444;
    line-height: 1.7;
}

/*====================================================
                BUTTONS
====================================================*/

.btn {
    border-radius: 10px;
    transition: .3s;
    font-weight: 600;
}

.btn-primary {
    background: #1565C0;
    border: none;
}

.btn-primary:hover {
    background: #0D47A1;
    transform: translateY(-3px);
}

/*====================================================
                PIPELINE
====================================================*/

.pipeline-card {

    max-width: 780px;

    width: 95%;

    margin: 40px auto;

    padding: 35px;

    border-radius: 25px;

    background: rgba(255, 255, 255, .94);

    backdrop-filter: blur(10px);

    box-shadow: 0 15px 35px rgba(0, 0, 0, .25);

}

.step {

    display: flex;

    align-items: flex-start;

    gap: 20px;

    margin-bottom: 22px;

}

.step .icon {

    width: 70px;

    height: 70px;

    background: #1565C0;

    color: white;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 34px;

    flex-shrink: 0;

    box-shadow: 0 5px 15px rgba(21, 101, 192, .35);

}

.step h3 {

    margin: 0;

    color: #003B95;

    font-size: 28px;

    font-weight: 700;

}

.step p {

    margin-top: 6px;

    color: #333;

    line-height: 1.7;

    font-size: 17px;

}

.step strong {

    color: #1565C0;

}

.arrow {

    text-align: center;

    font-size: 34px;

    color: #1565C0;

    font-weight: bold;

    margin: 15px 0;

}

.quantum .icon {

    background: #7B1FA2;

}

.output .icon {

    background: #2E7D32;

}

/*====================================================
                FORM
====================================================*/

.form-control {

    border-radius: 12px;

    border: 2px dashed #1565C0;

    padding: 15px;

}

.form-control:hover {

    border-color: #0D47A1;

}

/*====================================================
                PREVIEW IMAGE
====================================================*/

#preview {

    max-width: 100%;

    max-height: 300px;

    border-radius: 15px;

    box-shadow: 0 10px 25px rgba(0, 0, 0, .25);

}

/*====================================================
                FOOTER
====================================================*/

.footer {

    margin-top: 60px;

    background: #021B3A;

    color: white;

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 18px 40px;

    font-size: 15px;

}

.footer strong {

    color: #00E5FF;

}

/*====================================================
                RESPONSIVE
====================================================*/

@media(max-width:768px) {

    .container {

        width: 95%;

    }

    .pipeline-card {

        padding: 20px;

    }

    .step {

        gap: 15px;

    }

    .step .icon {

        width: 55px;

        height: 55px;

        font-size: 28px;

    }

    .step h3 {

        font-size: 23px;

    }

    .step p {

        font-size: 15px;

    }

    .footer {

        flex-direction: column;

        gap: 10px;

        text-align: center;

        padding: 20px;

    }

}

/*====================================================
                FEATURE CARDS
====================================================*/

.feature-card {

    position: relative;
    background: #ffffff;
    border-radius: 18px;
    padding: 25px 15px;
    text-align: center;
    height: 100%;

    transition: all .35s ease;

    box-shadow: 0 10px 25px rgba(0, 0, 0, .12);

    cursor: pointer;

    overflow: visible;
}

.feature-card:hover {

    transform: translateY(-10px) scale(1.03);

    box-shadow: 0 20px 45px rgba(21, 101, 192, .30);

}

.feature-icon {

    width: 70px;

    height: 70px;

    margin: auto;

    border-radius: 50%;

    background: #1565C0;

    color: #fff;

    display: flex;

    justify-content: center;

    align-items: center;

    font-size: 30px;

    margin-bottom: 15px;

}

.feature-card h5 {

    color: #1565C0;

    font-weight: 700;

    margin-bottom: 15px;

}

.feature-card p {

    color: #555;

    line-height: 1.7;

}

/*====================================================
                POPUP
====================================================*/

.popup-info {

    position: absolute;

    left: 50%;

    bottom: 110%;

    transform: translateX(-50%) translateY(15px);

    width: 250px;

    background: #1565C0;

    color: #fff;

    padding: 18px;

    border-radius: 15px;

    text-align: left;

    box-shadow: 0 15px 40px rgba(0, 0, 0, .25);

    opacity: 0;

    visibility: hidden;

    transition: all .35s ease;

    z-index: 999;

}

.popup-info h6 {

    margin: 0 0 8px;

    font-weight: 700;

}

.popup-info hr {

    border: 1px solid rgba(255, 255, 255, .35);

    margin: 8px 0 12px;

}

.feature-card:hover .popup-info {

    opacity: 1;

    visibility: visible;

    transform: translateX(-50%) translateY(0);

}

/* Small popup arrow */

.popup-info::after {

    content: "";

    position: absolute;

    top: 100%;

    left: 50%;

    transform: translateX(-50%);

    border-width: 10px;

    border-style: solid;

    border-color: #1565C0 transparent transparent transparent;

}
